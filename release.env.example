# quota-viewer 发布配置模板
# 复制为 release.env 并填写真实值(真实文件已 gitignore,绝不入库)。

# 版本清单公开地址(客户端经 ldflags 内置该地址,必须 https,对应 bucket 公共读)
# 形如 https://<bucket名>.<endpoint>/quota-viewer/version.json
UPDATE_MANIFEST_URL=

# 阿里云 OSS 写凭证(建议专用 RAM 子账号,仅授予该 bucket 写权限)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 如 oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
OSS_BUCKET=
